# Copy to .env (git-ignored). Both values come from the Moss portal: project id + an API key.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Optional: hard spending cap enforced by the local ledger (USD)
MOSS_BUDGET_CAP_USD=8.0
# Set to 1 to let pytest run the tests marked `paid`
MOSS_PAID_TESTS=0
# Where the client runs (a label, not a hostname); every latency result is scoped to it
MOSS_AUDIT_CLIENT=hetzner-vps-nuremberg-de
